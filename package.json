{
  "name": "smartzap-cf",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "predev": "node scripts/prepare-dev.mjs",
    "dev": "vite dev",
    "build": "vite build",
    "postbuild": "node scripts/sanitize-build.mjs",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run --max-workers=1",
    "test:watch": "vitest --max-workers=1",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply smartzap --local",
    "db:migrate:e2e": "CI=1 wrangler d1 migrations apply smartzap-test --config config/wrangler.test.jsonc --local --persist-to .wrangler/e2e-state",
    "db:seed:e2e": "CI=1 wrangler d1 execute smartzap-test --config config/wrangler.test.jsonc --local --persist-to .wrangler/e2e-state --file scripts/e2e-seed.sql",
    "e2e": "npm run db:migrate:e2e && npm run db:seed:e2e && playwright test",
    "validate:flow": "node --experimental-strip-types scripts/validate-flow-json.mjs",
    "pricing:sync-rate-card": "node scripts/sync-meta-rate-card.mjs",
    "visual:campaigns": "node scripts/visual-diff-campaigns.mjs",
    "visual:campaign-detail": "node scripts/visual-diff-campaign-detail.mjs",
    "visual:campaign-list": "node scripts/visual-diff-campaign-list.mjs",
    "visual:inbox": "node scripts/visual-diff-inbox.mjs",
    "visual:contacts": "node scripts/visual-diff-contacts.mjs",
    "visual:contacts:contract": "node scripts/visual-contract-contacts.mjs",
    "audit:contact-surfaces": "node scripts/audit-contact-surfaces.mjs",
    "e2e:contacts": "node scripts/e2e-contacts.mjs",
    "e2e:contact-import": "node scripts/e2e-contact-import.mjs",
    "e2e:inbox": "node scripts/e2e-inbox.mjs",
    "visual:templates": "node scripts/visual-diff-templates.mjs",
    "e2e:flow-builder": "node scripts/e2e-flow-builder.mjs",
    "e2e:flow-builder-home": "node scripts/e2e-flow-builder-home.mjs",
    "e2e:template-project": "node scripts/e2e-template-project.mjs",
    "visual:template-project": "node scripts/visual-diff-template-project.mjs",
    "visual:routes": "node scripts/visual-diff-route-matrix.mjs",
    "e2e:template-factory": "node scripts/e2e-template-factory.mjs",
    "capture:legacy-ai": "node scripts/capture-legacy-ai.mjs",
    "e2e:ai-agents": "node scripts/e2e-ai-agents.mjs",
    "e2e:workflows": "node scripts/e2e-workflows.mjs",
    "e2e:attendant-portal": "node scripts/e2e-attendant-portal.mjs",
    "qa:validate": "node scripts/qa-runner.mjs validate",
    "qa:preflight": "node scripts/qa-runner.mjs preflight",
    "qa:unit": "node scripts/qa-runner.mjs unit",
    "qa:contract": "node scripts/qa-runner.mjs contract",
    "qa:e2e:p0": "node scripts/qa-runner.mjs e2e:p0",
    "qa:e2e:matrix": "node scripts/qa-runner.mjs e2e:matrix",
    "qa:visual": "node scripts/qa-runner.mjs visual",
    "qa:ai": "node scripts/qa-runner.mjs ai",
    "qa:meta:canary": "node scripts/qa-runner.mjs meta:canary",
    "qa:cleanup": "node scripts/qa-runner.mjs cleanup",
    "qa:remote:health": "node scripts/qa-remote-health.mjs",
    "qa:rollback:staging": "node scripts/qa-rollback-drill.mjs",
    "qa:all": "node scripts/qa-runner.mjs all",
    "qa:release": "node scripts/qa-runner.mjs release"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@openai/codex-security": "^0.1.1",
    "@xyflow/react": "^12.11.2",
    "hono": "^4.12.30",
    "libphonenumber-js": "^1.13.8",
    "papaparse": "^5.5.4",
    "pdfjs-dist": "^6.1.200",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "^1.48.0",
    "@cloudflare/vitest-pool-workers": "^0.19.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  }
}
