{
  "name": "smartzap-cf",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "predev": "node scripts/prepare-dev.mjs",
    "dev": "vite dev",
    "build": "vite build",
    "postbuild": "node scripts/sanitize-build.mjs",
    "deploy": "npm run build && wrangler deploy",
    "test": "npm run test:workers && npm run test:node",
    "test:workers": "npm run test:workers:1 && npm run test:workers:2",
    "test:workers:1": "vitest run --config vitest.config.ts --max-workers=1 --shard=1/2",
    "test:workers:2": "vitest run --config vitest.config.ts --max-workers=1 --shard=2/2",
    "test:node": "vitest run --config vitest.node.config.ts --max-workers=1",
    "test:watch": "vitest --config vitest.config.ts --max-workers=1",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply smartzap --local",
    "db:migrate:e2e": "CI=1 wrangler d1 migrations apply smartzap-test --config config/wrangler.test.jsonc --local --persist-to .wrangler/e2e-state",
    "db:seed:e2e": "CI=1 wrangler d1 execute smartzap-test --config config/wrangler.test.jsonc --local --persist-to .wrangler/e2e-state --file scripts/e2e-seed.sql",
    "e2e": "npm run db:migrate:e2e && npm run db:seed:e2e && playwright test",
    "validate:flow": "node --experimental-strip-types scripts/validate-flow-json.mjs",
    "pricing:sync-rate-card": "node scripts/sync-meta-rate-card.mjs",
    "visual:campaigns": "node scripts/visual-diff-campaigns.mjs",
    "visual:campaign-detail": "node scripts/visual-diff-campaign-detail.mjs",
    "visual:campaign-list": "node scripts/visual-diff-campaign-list.mjs",
    "visual:inbox": "node scripts/visual-diff-inbox.mjs",
    "visual:contacts": "node scripts/visual-diff-contacts.mjs",
    "visual:contacts:contract": "node scripts/visual-contract-contacts.mjs",
    "audit:contact-surfaces": "node scripts/audit-contact-surfaces.mjs",
    "e2e:contacts": "node scripts/e2e-contacts.mjs",
    "e2e:contact-import": "node scripts/e2e-contact-import.mjs",
    "e2e:inbox": "node scripts/e2e-inbox.mjs",
    "visual:templates": "node scripts/visual-diff-templates.mjs",
    "e2e:flow-builder": "node scripts/e2e-flow-builder.mjs",
    "e2e:flow-builder-home": "node scripts/e2e-flow-builder-home.mjs",
    "e2e:template-project": "node scripts/e2e-template-project.mjs",
    "visual:template-project": "node scripts/visual-diff-template-project.mjs",
    "visual:routes": "node scripts/visual-diff-route-matrix.mjs",
    "e2e:template-factory": "node scripts/e2e-template-factory.mjs",
    "capture:legacy-ai": "node scripts/capture-legacy-ai.mjs",
    "e2e:ai-agents": "node scripts/e2e-ai-agents.mjs",
    "e2e:workflows": "node scripts/e2e-workflows.mjs",
    "e2e:attendant-portal": "node scripts/e2e-attendant-portal.mjs",
    "qa:validate": "node scripts/qa-runner.mjs validate",
    "qa:preflight": "node scripts/qa-runner.mjs preflight",
    "qa:unit": "node scripts/qa-runner.mjs unit",
    "qa:contract": "node scripts/qa-runner.mjs contract",
    "qa:e2e:p0": "node scripts/qa-runner.mjs e2e:p0",
    "qa:e2e:matrix": "node scripts/qa-runner.mjs e2e:matrix",
    "qa:miniapps:matrix": "node scripts/validate-miniapps-functional-matrix.mjs",
    "qa:miniapps:functional": "vitest run --config vitest.config.ts --max-workers=1 tests/domain/miniapps-functional-matrix.test.ts",
    "qa:miniapps:meta": "node scripts/qa-miniapps-meta-canary.mjs",
    "qa:miniapps:homologate": "node --experimental-strip-types scripts/qa-miniapps-real-homologation.mjs",
    "qa:miniapps:stress": "node scripts/qa-miniapps-stress.mjs",
    "qa:visual": "node scripts/qa-runner.mjs visual",
    "qa:ai": "node scripts/qa-runner.mjs ai",
    "qa:ai:human:prepare": "node scripts/qa-ai-human-calibration.mjs prepare",
    "qa:ai:human:verify": "node scripts/qa-ai-human-calibration.mjs verify",
    "qa:a11y:manual:prepare": "node scripts/qa-manual-accessibility.mjs prepare",
    "qa:a11y:manual:verify": "node scripts/qa-manual-accessibility.mjs verify",
    "qa:risk:prepare": "node scripts/qa-release-risk.mjs prepare",
    "qa:risk:verify": "node scripts/qa-release-risk.mjs verify",
    "qa:soak:finalize": "node scripts/qa-soak-finalize.mjs",
    "qa:security:isolation": "node scripts/qa-security-isolation.mjs",
    "qa:backup:restore": "node scripts/qa-backup-restore.mjs",
    "qa:certification:prepare": "node scripts/qa-production-certification.mjs prepare",
    "qa:certification:verify": "node scripts/qa-production-certification.mjs verify",
    "qa:meta:canary": "node scripts/qa-runner.mjs meta:canary",
    "qa:meta:templates": "node scripts/qa-template-category-canary.mjs",
    "qa:meta:template-lifecycle": "node scripts/qa-template-lifecycle-canary.mjs",
    "qa:meta:template-components": "node scripts/qa-template-components-canary.mjs",
    "qa:meta:app-callback": "node scripts/qa-meta-app-callback-switch.mjs",
    "qa:meta:bsuid": "node scripts/qa-meta-bsuid.mjs",
    "qa:meta:template-status": "node scripts/qa-template-status-observer.mjs",
    "qa:meta:template-projects": "node scripts/qa-template-projects-meta-canary.mjs",
    "qa:template-projects:stress": "node scripts/qa-template-projects-stress.mjs",
    "qa:cleanup": "node scripts/qa-runner.mjs cleanup",
    "qa:remote:health": "node scripts/qa-remote-health.mjs",
    "qa:production:rotate-readonly-key": "node scripts/qa-sync-production-readonly-secret.mjs --rotate",
    "qa:staging:rotate-readonly-key": "node scripts/qa-sync-production-readonly-secret.mjs --rotate --staging",
    "qa:rollback:staging": "node scripts/qa-rollback-drill.mjs",
    "qa:all": "node scripts/qa-runner.mjs all",
    "qa:release": "node scripts/qa-runner.mjs release"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "hono": "4.13.0",
    "libphonenumber-js": "^1.13.8",
    "papaparse": "^5.5.4",
    "pdfjs-dist": "^6.2.108",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "1.50.0",
    "@cloudflare/vitest-pool-workers": "0.20.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "undici": "7.29.0",
    "fast-uri": "3.1.5"
  }
}
