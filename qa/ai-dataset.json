      "id": "OPS-06",
      "group": "operacao",
      "kind": "llm",
      "messages": [
        {"role": "assistant", "text": "Qual é o seu volume aproximado?"},
        {"role": "user", "text": "São 2.000 contatos."},
        {"role": "assistant", "text": "Entendi: aproximadamente 2.000 contatos. Qual é sua empresa?"},
        {"role": "user", "text": "São 2.000, como eu já disse. Minha empresa é Horizonte."}
