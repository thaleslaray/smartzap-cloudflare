      "group": "comercial",
      "kind": "llm",
      "messages": [
        {"role": "assistant", "text": "Qual é seu nome e sua empresa?"},
        {"role": "user", "text": "Sou Ana, da Aurora. Quero organizar campanhas e temos cerca de 800 contatos."},
        {"role": "assistant", "text": "Entendi seu objetivo e volume."},
        {"role": "user", "text": "Qual seria o próximo passo?"}
